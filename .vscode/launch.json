{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Super Fast General Debugger",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/bin/${input:targetName}",
      "args": [
        "--first_date", "5376",
        "--val_length", "1344",
        "--start_k", "0",
        "--end_k", "5",
        "--run", "abo,qrd,krls",
        //"--run", "krls",
        "--abo_lags", "20",
        "--abo_window", "22",
        "--abo_sigma", "6.5",
        "--abo_log2D", "13",
        "--qrd_lags", "20",
        "--qrd_window", "272",
        "--krls_lags", "20",
        "--krls_window", "761",
        //"--krls_sigma", "3.125"
        "--krls_sigma", ".31"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build"
    }
  ],
  "inputs": [
    {
      "id": "targetName",
      "type": "pickString",
      "description": "Which target do you want to build and debug?",
      "default": "gridsearch_eurusd_test_best_bench",
      "options": [
        "gridsearch_eurusd_test_best_bench",
        "gridsearch_eurusd_test_best",
        "gridsearch_test_best",
        "gridsearch_test_best_bench",
        "EURUSD_test",
        "elect_test",
        "dd_test"
      ]
    }
  ]
}